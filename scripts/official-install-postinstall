#!/bin/zsh -f
set -euo pipefail
export PATH=/usr/bin:/bin:/usr/sbin:/sbin
umask 077

fail() { print -u2 -- "$*"; exit 1; }
(( EUID == 0 )) && [[ "$3" == / ]] || fail 'Install on the current macOS startup volume.'
readonly parent='/Library/local.mymachine.app'
readonly app="$parent/MY MACHINE.app"
readonly marker="$parent/fan-migration-complete"
readonly legacy='system/local.mymachine.fancontrol'
readonly service='system/local.mymachine.fancontrol.service'
readonly legacy_plist='/Library/LaunchDaemons/local.mymachine.fancontrol.plist'
readonly legacy_app='/Library/PrivilegedHelperTools/local.mymachine.fancontrol.app'
readonly requirement='anchor apple generic and identifier "local.mymachine.app" and certificate leaf[field.1.2.840.113635.100.6.1.13] exists and certificate leaf[subject.OU] = "@DEVELOPER_TEAM@"'

protected_dir() {
    [[ -d "$1" && ! -L "$1" ]] || return 1
    local mode="$(/usr/bin/stat -f '%p' "$1")"
    [[ "$(/usr/bin/stat -f '%u' "$1")" == 0 ]] || return 1
    (( (8#$mode & 8#6022) == 0 )) || return 1
    # Accept only directories with no extended ACL at these few install paths.
    local listing="$(/bin/ls -lde "$1")"
    [[ "$listing" != *$'\n'* ]]
}
for directory in / /Library; do protected_dir "$directory" || fail "Unprotected directory: $directory"; done
if [[ ! -e "$parent" && ! -L "$parent" ]]; then /bin/mkdir -m 755 "$parent"; fi
protected_dir "$parent" || fail 'The MY MACHINE install directory is unprotected.'
# Installer serializes package operations. Recover staging left by a forced
# interruption before starting again, and only inside the protected parent.
stage="$parent/.install-stage"
restorePrevious() {
    if [[ -d "$stage/Previous.app" && ! -e "$app" && ! -L "$app" ]]; then
        /bin/mv "$stage/Previous.app" "$app"
    fi
}
if [[ -e "$stage" || -L "$stage" ]]; then
    protected_dir "$stage" || fail 'Unexpected installation staging directory.'
    restorePrevious
    /bin/rm -rfx -- "$stage"
fi
/bin/mkdir -m 700 "$stage"
cleanup() {
    restorePrevious || return
    /bin/rm -rfx -- "$stage"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

source_app="${0:A:h}/MY MACHINE.app"
/usr/bin/ditto --noacl --noqtn "$source_app" "$stage/Helper.app"
if [[ -n "$(/usr/bin/find "$stage/Helper.app" ! -type d ! -type f -print -quit)" ]]; then
    fail 'Unexpected object in the signed application payload.'
fi
/usr/sbin/chown -R root:wheel "$stage/Helper.app"
/bin/chmod -RN "$stage/Helper.app"
/usr/bin/find "$stage/Helper.app" -type d -exec /bin/chmod 755 {} +
/usr/bin/find "$stage/Helper.app" -type f -exec /bin/chmod 644 {} +
/bin/chmod 755 "$stage/Helper.app/Contents/MacOS/DailyMac"
/usr/bin/codesign --verify --deep --strict --all-architectures -R "$requirement" "$stage/Helper.app"
/usr/sbin/spctl --assess --type execute "$stage/Helper.app"

# Retire the old daemon without running anything from its bundle.
if [[ -e "$legacy_plist" || -L "$legacy_plist" || -e "$legacy_app" || -L "$legacy_app" ]] ||
   /bin/launchctl print "$legacy" >/dev/null 2>&1; then
    /bin/launchctl disable "$legacy"
fi
/bin/rm -f -- "$marker"
for job in "$legacy" "$service"; do
    if /bin/launchctl print "$job" >/dev/null 2>&1; then /bin/launchctl bootout "$job"; fi
    if /bin/launchctl print "$job" >/dev/null 2>&1; then fail "Could not stop $job."; fi
done

if [[ -e "$app" || -L "$app" ]]; then
    protected_dir "$app" || fail 'Existing app path is not protected.'
    /bin/mv "$app" "$stage/Previous.app"
fi
/bin/mv "$stage/Helper.app" "$app"

for attempt in 1 2 3 4 5; do
    if "$app/Contents/MacOS/DailyMac" --fan-helper-restore; then
        for directory in /Library/LaunchDaemons /Library/PrivilegedHelperTools; do
            if [[ -e "$directory" || -L "$directory" ]]; then
                protected_dir "$directory" || fail "Unprotected legacy directory: $directory"
            fi
        done
        if [[ -d "$legacy_app" && ! -L "$legacy_app" ]]; then
            [[ "$(/usr/bin/stat -f %d "$legacy_app")" == "$(/usr/bin/stat -f %d "${legacy_app:h}")" ]] ||
                fail 'The legacy helper path is a separate filesystem.'
        fi
        /bin/rm -f -- "$legacy_plist"
        /bin/rm -rfx -- "$legacy_app"
        /usr/bin/install -m 644 -o root -g wheel /dev/null "$marker"
        exit 0
    fi
    /bin/sleep 1
done
print -u2 'MY MACHINE monitoring is installed. Fan recovery is pending. Run the official installer again after recovery is possible.'
